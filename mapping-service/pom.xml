<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>org.phoebus</groupId>
    <artifactId>pva-mapping-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>PVA Mapping Service</name>
    <description>
        Configuration-driven Spring Boot service that scrapes metrics endpoints and
        publishes a curated set of EPICS PVA channels for control room OPI screens.
    </description>

    <properties>
        <java.version>17</java.version>
        <core-pva.version>5.0.2</core-pva.version>
        <mockwebserver.version>5.4.0</mockwebserver.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            spring-boot-starter-json: provides jackson-databind and triggers
            JacksonAutoConfiguration so an ObjectMapper bean is available for injection.
            Also pulls in jackson-datatype-jsr310 (Java 8 time support) and
            jackson-dataformat-yaml (YAML body parsing in JsonScraper).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!--
            micrometer-registry-pva: sibling library that publishes Micrometer meters as
            EPICS PVA NTScalar channels.  Gauges returning NaN are automatically published
            with INVALID alarm; the mapping service registers one Gauge per configured channel.
            Transitively provides core-pva and micrometer-core.
        -->
        <dependency>
            <groupId>org.phoebus</groupId>
            <artifactId>micrometer-registry-pva</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- ============================================================
             Test dependencies
             ============================================================ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            MockWebServer: lightweight in-process HTTP stub server used by scraper unit
            tests and the end-to-end integration test.
        -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${mockwebserver.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${mockwebserver.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                Force IPv4 so that PVAServer does not attempt to bind on IPv6
                interfaces (which are unavailable in many CI environments).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.net.preferIPv4Stack=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
